# ══════════════════════════════════════════════════════════════
# RadAssist AI — Git Ignore
# ══════════════════════════════════════════════════════════════

# ── Environment files (SECRETS!) ──────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
env/
*.whl
pip-log.txt

# ── Node.js ───────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
# NOTE: package-lock.json is deliberately NOT ignored. It pins exact
# dependency versions so `npm ci` reproduces identical builds, and the
# frontend Dockerfile copies it. Ignoring lockfiles breaks reproducibility.

# ── Docker ────────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Project document ─────────────────────────────────────────
*.docx

# ── Uploads & model cache ─────────────────────────────────────
backend/uploads/
backend/.hf_cache/
.cache/

# ── Misc ──────────────────────────────────────────────────────
*.log
.agents/
