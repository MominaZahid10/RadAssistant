# ══════════════════════════════════════════════════════════════
# RadAssistant — production stack settings
# ══════════════════════════════════════════════════════════════
# Copy to `.env` in the REPOSITORY ROOT (next to docker-compose.prod.yml):
#
#     cp env.prod.example .env
#
# ⚠️  THIS IS NOT backend/.env. Two files, two jobs:
#
#   .env (here)      — read by DOCKER COMPOSE to fill ${...} in the compose
#                      file: database credentials, hostnames, which Caddyfile.
#   backend/.env     — read by the APPLICATION: API keys, JWT secret,
#                      CORS_ORIGINS.
#
# Compose does not pass this file into the backend container, and the backend
# never sees it. Putting your GROQ_API_KEY here would silently do nothing.
# ══════════════════════════════════════════════════════════════

# ── Where things live ─────────────────────────────────────────
# The default deployment is SPLIT: the Next.js app on Vercel, this server
# running the API, Postgres and Qdrant.

# The public hostname of THIS SERVER — the API.
# With sslip.io the hostname IS the server's IP with dots replaced by dashes,
# so 203.0.113.5 becomes 203-0-113-5.sslip.io. No DNS record to create.
#
# ⚠️  IF LET'S ENCRYPT REFUSES, SWAP sslip.io FOR nip.io.
# Both embed the IP identically, and sslip.io's own documentation recommends
# trying the other when one is rate-limited — they are separate registered
# domains with separate allowances, so it is a real fix, not a retry.
SITE_ADDRESS=203-0-113-5.sslip.io

# Where the app itself lives. Anyone hitting the bare API hostname gets
# redirected here. Set this AFTER Vercel gives you a URL.
APP_URL=https://radassistant.vercel.app

# ── Which Caddyfile ───────────────────────────────────────────
#   ./Caddyfile              API only; app on Vercel        (default)
#   ./Caddyfile.selfhosted   API + app served from this box
#
# The self-hosted variant also needs the frontend container, which is behind
# a profile:
#     docker compose -f docker-compose.prod.yml --profile selfhosted up -d
CADDYFILE=./Caddyfile

# ── Frontend build (self-hosted mode only) ────────────────────
# ⚠️  IGNORED IN THE DEFAULT SPLIT DEPLOYMENT. When the app is on Vercel,
# this value is set in VERCEL's environment variables, not here — the
# frontend is built there, not on this server.
#
# Only relevant with --profile selfhosted. Origin only: no "/api", no
# trailing slash. lib/api.ts appends /api/v1/... itself, so a path here
# produces /api/api/v1/chat and every request 404s.
PUBLIC_API_URL=https://203-0-113-5.sslip.io

# ── Database ──────────────────────────────────────────────────
# ⚠️  NOT the value from the dev compose file. That one is committed to git
# and therefore public. Generate a fresh password:
#     openssl rand -base64 24
POSTGRES_USER=radassist
POSTGRES_PASSWORD=
POSTGRES_DB=radassist_db

# ── Spend ceilings ────────────────────────────────────────────
# See backend/.env.example for what these mean and what they do not
# guarantee. Set a hard cap on the model provider's dashboard as well.
CHAT_DAILY_PER_USER=200
CHAT_DAILY_PER_INSTANCE=1000

# ── First boot only ───────────────────────────────────────────
# ⚠️  SET THIS TO 0 FOR THE VERY FIRST `up`, THEN BACK TO 1.
# backend/.hf_cache is empty on a fresh server. With offline mode on, the
# embedding and reranker models cannot download — and the app starts anyway,
# because a model load failure is caught rather than fatal. The symptom is
# not an error: ingestion runs, reports success, and produces zero chunks.
#
# Leave it at 1 afterwards so restarts are fast and do not depend on
# huggingface.co being reachable.
HF_HUB_OFFLINE=1

# ── Retrieval tuning (leave alone unless you have run the eval) ──
RERANK_ENABLED=true
RERANK_CANDIDATES=48
RETRIEVAL_LIMIT=12
MAX_CHUNKS_PER_DOCUMENT=3
VISION_ENABLED=true
