# ══════════════════════════════════════════════════════════════
# RadAssist AI — backend environment
# ══════════════════════════════════════════════════════════════
#
#   cp .env.example .env    and fill in the marked values.
#
# Only JWT_SECRET and one LLM key are required to start. Everything else
# has a working default and is here so you know it exists.
#
# ⚠️  NEVER COMMIT .env — it is gitignored, and it holds live API keys.
# ══════════════════════════════════════════════════════════════


# ── REQUIRED: token signing ───────────────────────────────────
# ⚠️  NO DEFAULT, DELIBERATELY. A signing key with a fallback value is a
# signing key that ships to production unchanged, and anyone who has read
# the source can then mint a valid token for any account.
#
# The app refuses to start if this is missing, shorter than 32 characters,
# or contains an obvious placeholder ("changeme", "secret", ...).
#
#   openssl rand -hex 32
#
JWT_SECRET=

# Twelve hours — one clinical shift. There are no refresh tokens, so this
# is exactly how long until someone has to sign in again.
JWT_EXPIRE_MINUTES=720

# ⚠️  SET THIS TO false FOR ANY CLINICAL DEPLOYMENT.
# true gives you ChatGPT-style self-service signup, which is right for a demo
# and wrong for a hospital. With it false, accounts come from:
#   docker-compose exec backend python scripts/create_user.py
ALLOW_REGISTRATION=true

MIN_PASSWORD_LENGTH=12


# ── REQUIRED: at least one LLM provider ───────────────────────
# Tried in order, with automatic failover. Groq is free and fast; OpenAI is
# the paid fallback and the intended production provider.
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

LLM_PROVIDER=groq
# Leave LLM_MODEL empty to use the provider's default.
#
# ⚠️  GROQ RETIRES MODELS AGGRESSIVELY — llama-3.3-70b-versatile shut down
# on 2026-08-16. If generation suddenly fails, check the deprecation list
# before debugging anything else. A test guards against defaulting to a
# known-retired id.
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── Daily spend ceilings ──────────────────────────────────────
# A per-minute rate limit stops a burst. It is not a budget: 20/min is
# ~28,800 calls a day. These bound the day.
#
# On a PUBLIC demo where everyone shares one published login,
# CHAT_DAILY_PER_USER is effectively the public allowance — "one account"
# is "everybody". CHAT_DAILY_PER_INSTANCE is the ceiling across all accounts.
#
# ⚠️  NEITHER REPLACES A HARD SPEND CAP ON THE PROVIDER'S DASHBOARD.
# These counters live in the API process and a restart clears them. Over a
# 60-second window that does not matter; over 24 hours it does. Set the
# provider-side cap too — that is the one a bug in this repo cannot bypass.
CHAT_DAILY_PER_USER=200
CHAT_DAILY_PER_INSTANCE=1000

# ── Public deployment ─────────────────────────────────────────
# ⚠️  SET THIS FALSE ON ANYTHING REACHABLE FROM THE INTERNET.
# With it true, anyone who finds the URL can create an account and spend
# your model budget. Create accounts with scripts/create_user.py instead.
# ALLOW_REGISTRATION=false


# ── Ingestion (needed only to build the corpus) ───────────────
# ⚠️  MUST BE A REAL, CONTACTABLE ADDRESS. NCBI's terms require it, and
# placeholder values are detected and rejected rather than silently used.
NCBI_EMAIL=
NCBI_API_KEY=


# ── Infrastructure (defaults match docker-compose) ────────────
DATABASE_URL=postgresql+asyncpg://radassist:radassist_secret@postgres:5432/radassist_db
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=radassist_knowledge


# ── Retrieval ─────────────────────────────────────────────────
# These are measured, not guessed. Turning either of the first two off
# costs real accuracy: vector-only scored 55.6% keyword@5, +rerank 72.2%,
# +hybrid 77.8%, +contextual chunk headers 94.4%.
RERANK_ENABLED=true
HYBRID_ENABLED=true
RERANK_CANDIDATES=48
LEXICAL_CANDIDATES=20
RETRIEVAL_LIMIT=12
# Stops one term-dense paper monopolising the whole context window.
MAX_CHUNKS_PER_DOCUMENT=3

CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384


# ── Vision (reading photographed reports) ─────────────────────
# ⚠️  THE ONLY VISION MODEL GROQ STILL SERVES. With VISION_ENABLED=false
# the system falls back to Tesseract OCR, which is materially worse — it
# read "hyperlordotic" as "hypoiordotic" on a low-resolution report,
# inverting the finding.
VISION_ENABLED=true
VISION_MODEL=qwen/qwen3.6-27b


# ── Development ───────────────────────────────────────────────
DEBUG=true

# ⚠️  LEAVE THIS false. SQL_ECHO logs every statement, including the INSERT
# that carries dictated findings and generated report text — which puts
# clinical content in the container logs. It is deliberately separate from
# DEBUG for exactly that reason.
SQL_ECHO=false
