# ══════════════════════════════════════════════════════════════
# RadAssist AI — Backend Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets!
# This .env.example is safe to commit as a template.
# ══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_NAME=RadAssist AI
APP_VERSION=0.1.0
DEBUG=true

# ── Database (Local Docker) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://radassist:radassist_secret@postgres:5432/radassist_db

# ── Vector Database (Qdrant) ─────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── LLM API Keys ─────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=mistral
