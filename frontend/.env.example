# ══════════════════════════════════════════════════════════════
# RadAssist AI — Frontend Environment Variables
# ══════════════════════════════════════════════════════════════
# NEXT_PUBLIC_ prefix = available in the browser (client-side)
# Without prefix = only available on the server (Next.js SSR)
# ══════════════════════════════════════════════════════════════

# Backend API URL — the frontend calls this to get data
# In Docker: backend service is at http://backend:8000
# On your local machine: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
